{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "lc": ["./runner/harness/ts/lc.ts"],
      "@/*": ["./playground/web/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "archive", "playground/web", "playground/tests/web", "playground/e2e/.tmp"]
}
