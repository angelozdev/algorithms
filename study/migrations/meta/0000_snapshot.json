        },
        "hints": {
          "name": "hints",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "active_ms": {
          "name": "active_ms",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "measured": {
          "name": "measured",
          "type": "integer",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "lang": {
          "name": "lang",
          "type": "text",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        }
      },
      "name": "attempt_stats",
      "isExisting": false,
      "definition": "\nSELECT\n  a.id AS attempt_id,\n  a.item_id AS item_id,\n  CASE\n    WHEN a.exam_id IS NOT NULL THEN 'exam'\n    WHEN EXISTS (\n      SELECT 1 FROM attempts p\n      WHERE p.item_id = a.item_id AND p.id <> a.id AND p.rating IS NOT NULL AND p.ended_at <= a.started_at\n    ) THEN 'review'\n    ELSE 'new'\n  END AS kind,\n  count(CASE WHEN g.type = 'hint' THEN 1 END) AS hints,\n  coalesce(sum(CASE WHEN g.gap <= 300000 THEN g.gap END), 0) AS active_ms,\n  count(CASE WHEN g.type IN ('edit', 'save', 'run') THEN 1 END) >= 3 AS measured,\n  (\n    SELECT e.lang FROM attempt_events e\n    WHERE e.attempt_id = a.id AND e.type = 'run'\n    ORDER BY e.at DESC, e.id DESC LIMIT 1\n  ) AS lang\nFROM attempts a\nLEFT JOIN (\n  SELECT attempt_id, type, at - lag(at) OVER (PARTITION BY attempt_id ORDER BY at, id) AS gap\n  FROM attempt_events\n) g ON g.attempt_id = a.id\nGROUP BY a.id\n"
    },
