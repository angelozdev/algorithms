{
  "entry": "orangesRotting",
  "params": [
    {"name":"grid","type":"int[][]"}
  ],
  "returns": "int",
  "compare": "exact",
  "examples": [
    {"input":[[[2,1,1],[1,1,0],[0,1,1]]],"expected":4},
    {"input":[[[2,1,1],[0,1,1],[1,0,1]]],"expected":-1},
    {"input":[[[0,2]]],"expected":0}
  ],
  "hidden": [
    {"input":[[[0]]],"expected":0},
    {"input":[[[1]]],"expected":-1},
    {"input":[[[2]]],"expected":0},
    {"input":[[[1,2]]],"expected":1},
    {"input":[[[1,0,2]]],"expected":-1},
    {"input":[[[2,2],[1,1]]],"expected":1},
    {"input":[[[2,1,2],[1,1,1],[2,1,2]]],"expected":2},
    {"input":[[[1,1],[1,1]]],"expected":-1},
    {"input":[[[2,1,1,1,2]]],"expected":2}
  ]
}
