{
  "entry": "isValidBST",
  "params": [
    {"name":"root","type":"TreeNode"}
  ],
  "returns": "bool",
  "compare": "exact",
  "examples": [
    {"input":[[2,1,3]],"expected":true},
    {"input":[[5,1,4,null,null,3,6]],"expected":false}
  ],
  "hidden": [
    {"input":[[1]],"expected":true},
    {"input":[[1,1]],"expected":false},
    {"input":[[10,5,15,null,null,6,20]],"expected":false},
    {"input":[[10,5,15,1,12]],"expected":false},
    {"input":[[10,5,15,null,null,10,20]],"expected":false},
    {"input":[[1,null,2,null,3]],"expected":true},
    {"input":[[0,-2147483648,2147483647]],"expected":true},
    {"input":[[-5,-10,0]],"expected":true}
  ]
}
