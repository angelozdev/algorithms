{
  "mode": "function",
  "entry": "containsDuplicate",
  "params": [
    {"name":"nums","type":"int[]"}
  ],
  "returns": "bool",
  "compare": "exact",
  "examples": [
    {"input":[[1,2,3,1]],"expected":true},
    {"input":[[1,2,3,4]],"expected":false},
    {"input":[[1,1,1,3,3,4,3,2,4,2]],"expected":true}
  ],
  "hidden": [
    {"input":[[1]],"expected":false},
    {"input":[[1,1]],"expected":true},
    {"input":[[0,0,0]],"expected":true},
    {"input":[[-1,-2,-3]],"expected":false},
    {"input":[[1,2,3,4,5]],"expected":false},
    {"input":[[5,4,3,2,1]],"expected":false},
    {"input":[[1000000000,-1000000000,1000000000]],"expected":true},
    {"input":[[-1000000000,1000000000]],"expected":false}
  ]
}
